datasource db {
  provider = "postgresql" // Or "sqlite" / "mysql" depending on your configuration setup
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("MEMBER") // ADMIN or MEMBER
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  //  Relationships
  // Projects created/managed by this user (if they are an Admin)
  ownedProjects Project[] @relation("ProjectOwner")
  
  // Tasks assigned directly to this user (if they are a Member)
  assignedTasks Task[]    @relation("TaskAssignee")
}

model Project {
  id          String   @id @default(uuid())
  name        String   // Matches 'name' parameter from controllers
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //  Link to the Admin who deployed this project
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  //  One-to-Many connection to the individual tasks inside this pipeline
  tasks       Task[]
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("PENDING")    // PENDING, IN_PROGRESS, COMPLETED
  priority    String    @default("MEDIUM")     // LOW, MEDIUM, HIGH
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  //  Link to the parent Project this task lives in
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  //  Link to the specific Team Member assigned to complete this task
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}